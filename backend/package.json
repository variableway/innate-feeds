{
  "name": "innate-feeds-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app/server.ts",
    "start": "tsx src/app/server.ts",
    "sync:daily": "tsx src/app/cli.ts sync trending daily",
    "sync:weekly": "tsx src/app/cli.ts sync trending weekly",
    "sync:monthly": "tsx src/app/cli.ts sync trending monthly",
    "sync:trending": "tsx src/app/cli.ts sync all-trending",
    "sync:starred": "tsx src/app/cli.ts sync starred",
    "sync:starred:recent": "tsx src/app/cli.ts sync starred --days 1",
    "import:static": "tsx src/data/import-static.ts",
    "list": "tsx src/app/cli.ts list",
    "list:trending": "tsx src/app/cli.ts list trending",
    "list:starred": "tsx src/app/cli.ts list starred",
    "dates": "tsx src/app/cli.ts dates",
    "stats": "tsx src/app/cli.ts stats",
    "export:static": "tsx src/data/export-static.ts",
    "export:incremental": "tsx src/data/export-incremental.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "better-sqlite3": "^11.8.0",
    "firecrawl": "^4.28.0",
    "hono": "^4.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
