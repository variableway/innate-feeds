{
  "name": "innate-feeds-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/app/server.ts",
    "build": "bun build src/app/server.ts --target=bun --minify --outdir=dist && bun build src/app/cli.ts --target=bun --minify --outfile=dist/cli.js",
    "start": "bun dist/server.js",
    "sync:daily": "bun src/app/cli.ts sync trending daily",
    "sync:weekly": "bun src/app/cli.ts sync trending weekly",
    "sync:monthly": "bun src/app/cli.ts sync trending monthly",
    "sync:trending": "bun src/app/cli.ts sync all-trending",
    "sync:starred": "bun src/app/cli.ts sync starred",
    "sync:starred:recent": "bun src/app/cli.ts sync starred --days 1",
    "sync:digest": "bun src/app/cli.ts sync digest --days 90",
    "sync:window": "bun src/app/cli.ts sync window",
    "sync:producthunt": "bun src/app/cli.ts sync producthunt",
    "sync:yc": "bun src/app/cli.ts sync yc",
    "sync:a16z": "bun src/app/cli.ts sync a16z",
    "sync:vc": "bun src/app/cli.ts sync vc",
    "sync:topics": "bun src/app/cli.ts sync github-topics",
    "topics:list": "bun src/app/cli.ts topics --list",
    "export:digest-local": "bun src/app/cli.ts sync digest",
    "import:static": "bun src/data/import-static.ts",
    "list": "bun src/app/cli.ts list",
    "list:trending": "bun src/app/cli.ts list trending",
    "list:starred": "bun src/app/cli.ts list starred",
    "dates": "bun src/app/cli.ts dates",
    "stats": "bun src/app/cli.ts stats",
    "export:static": "bun src/data/export-static.ts",
    "export:incremental": "bun src/data/export-incremental.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "firecrawl": "^4.28.0",
    "hono": "^4.7.0",
    "js-yaml": "^4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
