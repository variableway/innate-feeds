{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["./src/*"],
      "@innate/shared/theme-catalog": ["../shared/theme-catalog.ts"],
      "@innate/shared/plugin-categories": ["../shared/plugin-categories.ts"]
    }
  },
  "include": ["src", "../shared/theme-catalog.ts", "../shared/plugin-categories.ts"]
}
