# innate-feeds / innate-hub configuration
#
# Copy to .env and edit. Innate-hub reads these at startup.
# Anything not set falls back to defaults in backend/internal/config/config.go.

# ==========================================
# Required
# ==========================================
FUSION_PASSWORD=your-secure-password
# When FUSION_PASSWORD is empty you must also set:
#   FUSION_ALLOW_EMPTY_PASSWORD=true

# ==========================================
# Server
# ==========================================
FUSION_PORT=8080

# Database driver is auto-detected from FUSION_DB_PATH:
#   - "postgres://..." or "postgresql://..." → PostgreSQL (uses pgvector when available)
#   - anything else → SQLite
# SQLite uses in-Go brute-force similarity search (fine for < ~10k items).
# PostgreSQL uses the pgvector `<=>` operator with an HNSW index (scales to millions).
FUSION_DB_PATH=hub.db

# ==========================================
# Puller / scheduler
# ==========================================
FUSION_PULL_INTERVAL=1800       # seconds between refreshes
FUSION_PULL_TIMEOUT=30          # per-request timeout
FUSION_PULL_CONCURRENCY=10      # max concurrent feed pulls
FUSION_PULL_MAX_BACKOFF=172800  # 48h max scheduling delay after failures

# ==========================================
# TrendRadar source
# ==========================================
# Path to TrendRadar's daily SQLite files. Default points to the sibling
# TrendRadar/ project in this repo.
TRENDRADAR_DATA_DIR=TrendRadar/output/news

# ==========================================
# Semantic search (vector embeddings)
# ==========================================
# Provider: "openai", "ollama", or empty (semantic search disabled).
HUB_EMBEDDER_PROVIDER=
# Model name, provider-specific:
#   OpenAI:  text-embedding-3-small (1536d), text-embedding-3-large (3072d), text-embedding-ada-002 (1536d)
#   Ollama:  nomic-embed-text (768d), mxbai-embed-large (1024d), all-minilm (384d), bge-small (384d), bge-large (1024d)
HUB_EMBEDDER_MODEL=
# Embedder endpoint / credentials.
HUB_EMBEDDER_API_KEY=
HUB_EMBEDDER_BASE_URL=
# Override the vector size. Leave empty to auto-detect from HUB_EMBEDDER_MODEL.
# The value is used to create the items.embedding_vec column on PostgreSQL.
# Changing it later requires: ALTER TABLE items ALTER COLUMN embedding_vec TYPE vector(<N>);
HUB_EMBEDDER_DIMENSIONS=

# ==========================================
# Fusion source plugins
# ==========================================
# JSON array; each object becomes one feed with source_type="fusion".
# Example: [{"name":"My Fusion","base_url":"https://fusion.example.com","username":"alice","password":"secret"}]
FUSION_SOURCES_JSON=

# ==========================================
# Output feed URLs (RSS/Atom/JSON Feed)
# ==========================================
# Absolute base URL embedded in feed links. Leave empty to derive from
# the request (X-Forwarded-Proto/Host). Set this when running behind a
# reverse proxy on a public domain.
# FUSION_PUBLIC_URL=https://hub.example.com

# ==========================================
# Auth / CORS / Logging
# ==========================================
# When OIDC is configured, users log in via the provider instead of the
# password. Uncomment and fill in to enable.
# FUSION_OIDC_ISSUER=https://accounts.google.com
# FUSION_OIDC_CLIENT_ID=...
# FUSION_OIDC_CLIENT_SECRET=...
# FUSION_OIDC_REDIRECT_URI=http://localhost:8080/api/oidc/callback
# FUSION_OIDC_ALLOWED_USER=

FUSION_CORS_ALLOWED_ORIGINS=
FUSION_TRUSTED_PROXIES=
FUSION_ALLOW_PRIVATE_FEEDS=false

FUSION_LOG_LEVEL=INFO
FUSION_LOG_FORMAT=auto

# Login brute-force protection
FUSION_LOGIN_RATE_LIMIT=10
FUSION_LOGIN_WINDOW=60
FUSION_LOGIN_BLOCK=300
